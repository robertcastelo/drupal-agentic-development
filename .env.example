# OpenChamber password — generated per-machine by ddev setup (DO NOT share)
# To reset: ddev env set OPENCHAMBER_PASSWORD=$(openssl rand -base64 12)
OPENCHAMBER_PASSWORD=your-own-password-here

# Provider API keys — per-developer. Uncomment in docker-compose.local.yaml too.
#
# OPENROUTER_API_KEY=
#
# ANTHROPIC_API_KEY=
#
# AWS Bedrock bearer token (generate in the Bedrock console)
# AWS_BEARER_TOKEN_BEDROCK=

# Default opencode/OpenChamber model (provider/model-id), e.g. openrouter/qwen/qwen3.8-max-0902
# OPENCODE_DEFAULT_MODEL=openrouter/qwen/qwen3.8-max-0902

# PHPUnit test environment.
#
# DDEV injects these into every container in the project, including web, where
# phpunit runs. They are read while containers are created, so `ddev restart`
# after changing any of them.
#
#   SIMPLETEST_BASE_URL          must resolve from inside the web container;
#                                http://web is that container's own name, so it
#                                works whatever the project is named.
#   SIMPLETEST_DB                matches web/sites/default/settings.ddev.php.
#                                Tests install into table prefixes of this same
#                                database, so the user needs CREATE/DROP.
#   BROWSERTEST_OUTPUT_DIRECTORY absolute path; phpunit runs from the project
#                                root while this sits under the docroot.
#                                Assumes docroot: web — adjust if yours differs.
#
# See "Adding PHPUnit testing" in .ddev/SETUP.md.
SIMPLETEST_BASE_URL=http://web
SIMPLETEST_DB=mysql://db:db@db:3306/db
BROWSERTEST_OUTPUT_DIRECTORY=/var/www/html/web/sites/simpletest/browser_output

