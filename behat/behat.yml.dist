# ddev-generated by ddev setup-behat (drupal-agentic-development)
#
# Behat configuration for this project. As long as the "ddev-generated by
# ddev setup-behat" header above is present, `ddev setup-behat` may (re)write
# this file from this template (picking up new module suites). Remove the
# header to take over manual management; re-runs will then leave it alone.
#
# DDEV-specific values are hard-coded on purpose:
#   base_url  http://web             the web container's own service name,
#                                    so it works whatever the project is named
#   wd_host   http://selenium:4444   the selenium service added by
#                                    docker-compose.selenium.yaml
# To point Behat at another site (e.g. a deployed environment) do not edit
# this file; override with the BEHAT_PARAMS environment variable instead (a
# JSON object merged over this config), e.g.:
#   export BEHAT_PARAMS='{"extensions":{"Drupal\\MinkExtension":{"base_url":"https://example.org"}}}'
default:
  autoload:
    - tests/bootstrap
  suites:
    default:
      paths:
        - tests/features
      contexts:
        - FeatureContext
        - Drupal\DrupalExtension\Context\DrupalContext
        - Drupal\DrupalExtension\Context\MinkContext
        - Drupal\DrupalExtension\Context\MessageContext
# (ddev setup-behat inserts a suite here for each custom module that has
# web/modules/custom/<module>/tests/behat/features)
#{{MODULE_SUITES}}
  extensions:
    Drupal\MinkExtension:
      browserkit_http: ~
      base_url: http://web
      selenium2:
        wd_host: http://selenium:4444/wd/hub
        browser: chrome
    Drupal\DrupalExtension:
      blackbox: ~
      api_driver: drush
      drush:
        root: web
        alias: '@self'
