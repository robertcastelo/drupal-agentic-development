#!/usr/bin/env bash
# One-time (or re-runnable) Behat setup for this project.
#
# Usage: ddev setup-behat [--no-selenium]
#
# What it does (idempotent - safe to re-run):
#   1. Installs drupal/drupal-extension (composer, dev) if not present.
#   2. Generates behat.yml at the project root from
#      .ddev/behat/behat.yml.dist. Re-runs regenerate it while the
#      "ddev-generated by ddev setup-behat" header is present; a file whose
#      header was removed is left untouched.
#   3. Creates a smoke feature (tests/features/front_page.feature) and an
#      empty FeatureContext (tests/bootstrap/FeatureContext.php) if missing.
#   4. Enables the selenium service for @javascript scenarios by copying
#      docker-compose.selenium.yaml.example to docker-compose.selenium.yaml
#      (skip with --no-selenium).
#   5. Writes STEPS.md (the step-definition catalog) and appends the
#      "Writing Behat Tests" block to AGENTS.md / CLAUDE.md if present, so
#      AI agents consult the catalog before inventing steps.
#
# Run this after `ddev start`. Then:
#   ddev restart
#   ddev behat

set -euo pipefail
shopt -s nullglob

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd)"
cd "$ROOT"

NO_SELENIUM=0
[ "${1:-}" = "--no-selenium" ] && NO_SELENIUM=1

TEMPLATE=".ddev/behat/behat.yml.dist"
if [ ! -f "$TEMPLATE" ]; then
  echo "ERROR: $TEMPLATE not found." >&2
  exit 1
fi

echo "==> Behat setup for $(basename "$ROOT")"

# 1. drupal/drupal-extension
if [ -d vendor/drupal/drupal-extension ]; then
  echo "    drupal/drupal-extension already installed."
else
  echo "    Installing drupal/drupal-extension (this runs composer)..."
  ddev composer require --dev drupal/drupal-extension:^6.1
fi

# 2. behat.yml - one suite per custom module that ships behat features.
MODULE_SUITES=""
for dir in web/modules/custom/*/tests/behat/features; do
  module="$(basename "$(dirname "$(dirname "$(dirname "$dir")")")")"
  MODULE_SUITES+="    ${module}:"$'\n'
  MODULE_SUITES+="      paths:"$'\n'
  MODULE_SUITES+="        - web/modules/custom/${module}/tests/behat/features"$'\n'
  MODULE_SUITES+="      contexts:"$'\n'
  MODULE_SUITES+="        - Drupal\\DrupalExtension\\Context\\DrupalContext"$'\n'
  MODULE_SUITES+="        - Drupal\\DrupalExtension\\Context\\MinkContext"$'\n'
  MODULE_SUITES+="        - Drupal\\DrupalExtension\\Context\\MessageContext"$'\n'
done

RENDERED="$(MODULE_SUITES="$MODULE_SUITES" awk '
  BEGIN { extra = ENVIRON["MODULE_SUITES"] }
  $0 == "#{{MODULE_SUITES}}" { if (extra != "") printf "%s", extra; next }
  { print }
' "$TEMPLATE")"

if [ -f behat.yml ] && ! head -5 behat.yml | grep -qF "ddev-generated by ddev setup-behat"; then
  echo "    behat.yml exists without the scaffold header - leaving untouched."
elif [ -f behat.yml ] && printf '%s\n' "$RENDERED" | diff -q - behat.yml >/dev/null 2>&1; then
  echo "    behat.yml already up to date."
else
  printf '%s\n' "$RENDERED" > behat.yml
  echo "    Wrote behat.yml."
fi

# 3. Smoke feature + empty context for custom steps.
mkdir -p tests/features tests/bootstrap
if [ ! -f tests/features/front_page.feature ]; then
  cat > tests/features/front_page.feature <<'EOF'
Feature: Site smoke test
  Verifies the installed site answers through the web server.

  Scenario: Front page loads
    Given I am on "/"
    Then I should get a 200 HTTP response
EOF
  echo "    Created tests/features/front_page.feature."
fi
if [ ! -f tests/bootstrap/FeatureContext.php ]; then
  cat > tests/bootstrap/FeatureContext.php <<'EOF'
<?php

/**
 * Project-level Behat context for custom step definitions.
 *
 * A class implementing the Behat Context interface is all a context needs
 * (behat 3.22 removed the old BehatContext base class). Add step
 * definitions with attributes, e.g.:
 *
 *   #[\Behat\Step\Given('my custom condition')]
 *   public function iHaveADoing(): void {}
 */
class FeatureContext implements \Behat\Behat\Context\Context
{
}
EOF
  echo "    Created tests/bootstrap/FeatureContext.php."
fi

# 4. Selenium service for @javascript scenarios.
NEED_RESTART=0
if [ "$NO_SELENIUM" -eq 1 ]; then
  echo "    Skipping selenium service (--no-selenium)."
elif [ -f .ddev/docker-compose.selenium.yaml ]; then
  echo "    selenium service already enabled."
elif [ -f .ddev/docker-compose.selenium.yaml.example ]; then
  cp .ddev/docker-compose.selenium.yaml.example .ddev/docker-compose.selenium.yaml
  echo "    Enabled the selenium service (docker-compose.selenium.yaml)."
  NEED_RESTART=1
else
  echo "    WARNING: no docker-compose.selenium.yaml(.example) found;"$'\n'
  echo "             @javascript scenarios will not work." >&2
fi

# 5. Step catalog + AI-writing block.
echo "    Generating STEPS.md..."
ddev exec -s web vendor/bin/behat -di > STEPS.md

for f in AGENTS.md CLAUDE.md; do
  if [ -f "$f" ] && ! grep -qF "behat test-writing block (ddev setup-behat)" "$f"; then
    cat >> "$f" <<'EOF'

<!-- ddev-generated: behat test-writing block (ddev setup-behat) -->
## Writing Behat Tests

Available step definitions are listed in STEPS.md.
Read this file before writing or modifying Behat tests.
Use only step patterns from this file. Do not invent steps.

If STEPS.md does not exist or is outdated, regenerate it:

    vendor/bin/behat -di > STEPS.md

Regenerate after adding new Context classes or updating dependencies.

The full step reference also lives at: vendor/drupal/drupal-extension/STEPS.md
EOF
    echo "    Appended the Behat writing block to $f."
  fi
done

if [ "$NEED_RESTART" -eq 1 ]; then
  echo "==> A ddev restart is required (new selenium service)."
fi
echo "==> Behat setup complete. Next:"
echo "    ddev restart"
echo "    ddev behat"
