{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["/home/opencode/.config/opencode/playwright-mcp-launch"],
      "enabled": true
    },
    "drupal_quality": {
      "type": "local",
      "command": ["node", "/home/opencode/.config/opencode/drupal-quality-mcp.mjs"],
      "enabled": true,
      "timeout": 300000
    },
    "drush": {
      "type": "local",
      "command": ["node", "/home/opencode/.config/opencode/drush-mcp.mjs"],
      "enabled": true,
      "timeout": 120000
    }
  }
}
